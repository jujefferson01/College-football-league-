{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conference",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "school_ids", "verification_status"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "school_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "verification_status": { "enum": ["draft", "needs_review", "verified"] },
    "notes": { "type": "string" }
  }
}
